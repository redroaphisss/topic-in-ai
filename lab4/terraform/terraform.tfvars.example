project_id = "YOUR_GCP_PROJECT_ID"
region     = "us-central1"
zone       = "us-central1-a" # GPU mode requires T4 quota in this zone

# Optional overrides:
# name_prefix  = "l4-lab"
# machine_type = "n1-standard-4"
# enable_gpu   = false # set true only if a GPU is required
# gpu_type     = "nvidia-tesla-t4"
# image_tag    = "lab"
# allow_cidr   = "0.0.0.0/0"
